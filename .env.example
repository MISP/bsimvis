PROJECT_NAME=bsimvis

# Data Directory (Absolute path recommended for remote/non-root)
# DATA_BASE_DIR=/home/thomas/projects/bsimvis/data

# Server Configuration
APP_HOST=0.0.0.0
APP_PORT=5000

# Redis Configuration (Job Queue)
REDIS_HOST=localhost
REDIS_PORT=6379

# Kvrocks Configuration (Data Storage)
KVROCKS_HOST=localhost
KVROCKS_PORT=6666

# Docker datastores: run Redis + Kvrocks from docker-compose.yml instead of
# building them in install.sh. Lighter setup for small machines.
DOCKER_DATASTORES=false
# Kvrocks container tuning (only used when DOCKER_DATASTORES=true)
# KVROCKS_BLOCK_CACHE_MB=1024
# KVROCKS_MEMORY_LIMIT=3G

# Milvus Configuration
ENABLE_MILVUS=false
# If ENABLE_MILVUS is true, set COMPOSE_PROFILES=milvus to start the containers
# COMPOSE_PROFILES=milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_HEALTH_PORT=9091

# MinIO Configuration
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Etcd Configuration
ETCD_PORT=2379

# Worker Configuration
# Defaults are sized for a 16 GB machine: 2 workers + 1 scan worker, each a
# Ghidra JVM capped at WORKER_MEMORY_MAX (3G), with HOST_RESERVED_GB left for
# kvrocks, redis and the desktop. The launcher caps WORKERS_COUNT by RAM anyway.
WORKERS_COUNT=2
# HOST_RESERVED_GB=6
# Workers reserved for the scan lane (--scan-only). They claim nothing
# else, so an interactive scan never queues behind a build.
SCAN_WORKERS_COUNT=1

# Ghidra Configuration
# GHIDRA_INSTALL_DIR=/path/to/ghidra_12.1_PUBLIC