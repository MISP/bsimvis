PROJECT_NAME=bsimvis

# Server Configuration
APP_HOST=0.0.0.0
APP_PORT=5000

# Redis Configuration (Job Queue)
REDIS_HOST=localhost
REDIS_PORT=6379

# Kvrocks Configuration (Data Storage)
KVROCKS_HOST=localhost
KVROCKS_PORT=6666

# Milvus Configuration
ENABLE_MILVUS=false
# If ENABLE_MILVUS is true, set COMPOSE_PROFILES=milvus to start the containers
# COMPOSE_PROFILES=milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_HEALTH_PORT=9091

# MinIO Configuration
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Etcd Configuration
ETCD_PORT=2379

# Worker Configuration
WORKERS_COUNT=5

# Ghidra Configuration
# GHIDRA_INSTALL_DIR=/path/to/ghidra_12.1_PUBLIC