[profiles.fast]
    description = "Fast analysis, focus on strings & functions"
    [profiles.fast.analyzers]
        # Heavy decompilation-based analyzers (DISABLE)
        "Decompiler Parameter ID" = false
        "Decompiler Switch Analysis" = false
        
        # Heavy data/archive analyzers (DISABLE)
        "Apply Data Archives" = false
        "Function ID" = false
        
        # Stack & Variable analyzers (DISABLE)
        "Stack" = false
        "Call Convention ID" = false
        
        # Keep features needed for strings and cross-referencing
        "Data Reference" = true
        "ASCII Strings" = true
    [profiles.fast.decompilation]

[profiles.full]
    description = "Comprehensive analysis (slow)"
    [profiles.full.analyzers]
        "Decompiler Parameter ID" = true
        "Stack" = true
        "Create Address Tables" = true
    [profiles.full.decompilation]


[profiles.no-analysis]
    description = "Decompile only"
    no_analysis = true
[clustering]
    # algorithm = "hdbscan" (default) or "leiden".
    # leiden = recursive community detection on the sparse similarity graph:
    # keeps low-cohesion parents for the dendrogram while surfacing tight
    # high-cohesion sub-groups that HDBSCAN's single-linkage buries.
    algorithm = "hdbscan"
    resolution = 1.0        # leiden granularity: higher -> smaller, tighter clusters
    stop_cohesion = 0.9     # leiden: stop recursing once a group is this cohesive
    epsilon = 0.001
    min_cluster_size = 2
    min_samples = 1
    selection_method = "eom"
    min_sim = 0.0
    min_features = 0
    min_cohesion = 0.5

[similarity]
    top_k = 1000
    min_score = 0.9
    # min_features: BSim floor. Functions below it match by exact FunctionID hash
    # instead (BSim is false-positive-prone on tiny funcs). 10 = canonical default.
    min_features = 10
    algo = "unweighted_cosine"


[llm]
    ollama_url = "http://localhost:11434"
    model = "qwen3.6:35b"
    prompt =  "Act as a senior reverse engineer. Provide a structured, keyword-focused summary of this function. **SUMMARY**: [One-line summary of functionality] **KEYWORDS**: [List 5-10 key technical terms, API calls, or algorithm names] **IMPACT**: [Side-effects, security implications, or critical dependencies] **LOGIC**: [Brief description of data transformation or logic path]"

[ghidra]
    max_ram_percent = 15.0
    jvm_args = []
