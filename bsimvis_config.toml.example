[profiles.fast]
    description = "Fast analysis, focus on strings & functions"
    [profiles.fast.analyzers]
        # Heavy decompilation-based analyzers (DISABLE)
        "Decompiler Parameter ID" = false
        "Decompiler Switch Analysis" = false
        
        # Heavy data/archive analyzers (DISABLE)
        "Apply Data Archives" = false
        "Function ID" = true
        "Function ID.Always Apply FID Labels" = true
        
        # Stack & Variable analyzers (DISABLE)
        "Stack" = false
        "Call Convention ID" = false
        
        # Keep features needed for strings and cross-referencing
        "Data Reference" = true
        "ASCII Strings" = true
    [profiles.fast.decompilation]

[profiles.full]
    description = "Comprehensive analysis (slow)"
    [profiles.full.analyzers]
        "Decompiler Parameter ID" = true
        "Stack" = true
        "Create Address Tables" = true
    [profiles.full.decompilation]


[profiles.no-analysis]
    description = "Decompile only"
    no_analysis = true
[clustering]
    epsilon = 0.001
    min_cluster_size = 2
    min_samples = 1
    selection_method = "eom"
    min_sim = 0.0
    min_features = 0
    min_cohesion = 0.5
    # Propagate cluster info to similarity-level indexes after clustering.
    # Powers `shared_clusters` in similarity search and sim-level cluster
    # filters. Slowest phase of a clustering run; set false to skip it.
    propagate_sim_indexes = true

[similarity]
    top_k = 1000
    min_score = 0.9
    # min_features: BSim floor. Functions below it match by exact FunctionID hash
    # instead (BSim is false-positive-prone on tiny funcs). 10 = canonical default.
    min_features = 10
    algo = "unweighted_cosine"


[llm]
    ollama_url = "http://localhost:11434"
    model = "qwen3.6:35b"
    prompt = "Act as a senior malware reverse engineer. Provide a concise, rapid-triage summary of this function. **TLDR**: [Maximum 2 sentences explaining the core purpose and intent] **KEY_EVIDENCE**: [Comma-separated list of ONLY the most critical Windows APIs, syscalls, or magic constants. Leave blank if none.]"

[ghidra]
    # Absolute JVM heap cap per worker. Each worker runs its own JVM, so keep
    # max_heap_mb * WORKERS_COUNT <= ~60% of host RAM (room for kvrocks + desktop).
    max_heap_mb = 1536
    # Only used by the bsimvis_upload CLI (single JVM, no fleet).
    max_ram_percent = 15.0
    # G1 never uncommits an idle heap by default (periodic GC is off in Java 21),
    # so each worker keeps its job high-water mark forever. These make it shrink
    # back toward the live set within 30s of going idle.
    jvm_args = [
        "-XX:G1PeriodicGCInterval=30000",
        "-XX:G1PeriodicGCSystemLoadThreshold=0",
        "-XX:MinHeapFreeRatio=10",
        "-XX:MaxHeapFreeRatio=30",
    ]

[search]
# Maximum index buckets one wildcard/substring filter may resolve to. Exact
# filters ignore it — they touch a single bucket. Results are still correct
# when it is hit, just a subset, and the response says so via
# `filter_truncated`. Cost is linear: ~0.13s scan + ~0.11s union per 60k
# buckets.
max_filter_buckets = 200000
